{
  "defaultProvider": "openai",
  "providers": {
    "openai": {
      "apiKey": "${OPENAI_API_KEY}",
      "model": "gpt-4",
      "temperature": 0.7,
      "maxTokens": 4000
    },
    "claude": {
      "apiKey": "${ANTHROPIC_API_KEY}",
      "model": "claude-3-opus-20240229",
      "temperature": 0.7,
      "maxTokens": 4000
    },
    "ollama": {
      "baseUrl": "${OLLAMA_BASE_URL:http://localhost:11434}",
      "model": "llama2",
      "temperature": 0.7
    }
  },
  "retryAttempts": 3,
  "timeout": 60000,
  "streaming": true
}
