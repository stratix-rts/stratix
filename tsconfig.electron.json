{
  "compilerOptions": {
    "outDir": "./dist/electron",
    "module": "commonjs",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "moduleResolution": "node",
    "sourceMap": true,
    "declaration": false,
    "declarationMap": false,
    "inlineSourceMap": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@stratix-core/*": ["src/stratix-core/*"]
    },
    "noEmitOnError": false
  },
  "include": ["src/electron/**/*", "src/agent-platform/**/*", "src/stratix-core/**/*", "src/stratix-gateway/**/*", "src/stratix-data-store/**/*", "src/stratix-database/**/*", "src/stratix-openclaw-adapter/**/*", "src/stratix-tailscale/**/*", "src/stratix-agent/**/*", "src/stratix-project/**/*", "src/stratix-lra-bridge/**/*", "src/stratix-nocodb/**/*"],
  "exclude": ["node_modules", "dist", "**/__tests__/**", "**/__mocks__/**"]
}
