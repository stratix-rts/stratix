{
  "name": "stratix",
  "version": "0.1.0",
  "description": "Stratix 星策系统 - 基于 Phaser RTS 游戏化界面的多 Agent 可视化指挥平台",
  "main": "dist/electron/electron/main.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "nodemon --watch src --ext ts,json --exec \"tsx src/stratix-gateway/index.ts\"",
    "dev:frontend": "vite",
    "test:rts": "vite --config vite.test-rts.config.ts",
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "tsc && tsc-alias",
    "build:frontend": "vite build",
    "analyze": "ANALYZE=true vite build",
    "typecheck": "tsc --noEmit",
    "typecheck:app": "tsc -p tsconfig.app.json --noEmit",
    "lint": "eslint src/**/*.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "prepare": "npx ts-node scripts/generate-agency-agents-json.ts",
    "clean": "rm -rf dist",
    "start": "node dist/stratix-gateway/index.js",
    "start:dev": "tsx src/stratix-gateway/index.ts",
    "electron": "NODE_PATH=dist/electron npm run build:electron && electron . --config electron.config.json",
    "electron:dev": "concurrently \"npm run dev:frontend\" \"npm run build:electron && electron . --config electron.config.json\"",
    "electron:build": "npm run build && npm run build:electron && electron-builder --config electron.config.json",
    "build:electron": "tsc -p tsconfig.electron.json && tsc-alias -p tsconfig.electron.json && node scripts/fix-electron-require.js",
    "tailscale:test": "tsx src/stratix-tailscale/test-embedded.ts",
    "tailscale:login": "tsx src/stratix-tailscale/interactive-login.ts",
    "nocodb:build": "cd vendor/nocodb && pnpm install && pnpm -r build --filter=nocodb",
    "nocodb:start": "node vendor/nocodb/packages/nocodb/dist/bundle.js",
    "nocodb:start:dev": "cd vendor/nocodb/packages/nocodb && pnpm start"
  },
  "keywords": [
    "stratix",
    "ai",
    "agent",
    "rts",
    "phaser",
    "openclaw",
    "tailscale"
  ],
  "author": "Stratix Team",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@langchain/anthropic": "^1.3.24",
    "@langchain/community": "^1.1.24",
    "@langchain/core": "^1.1.33",
    "@langchain/google-genai": "^2.1.26",
    "@langchain/langgraph": "^1.2.3",
    "@langchain/ollama": "^1.2.6",
    "@langchain/openai": "^1.3.0",
    "@noble/ed25519": "^3.0.0",
    "@types/handlebars": "^4.1.0",
    "@types/lodash-es": "^4.17.12",
    "axios": "^1.13.5",
    "better-sqlite3": "^12.8.0",
    "chokidar": "^5.0.0",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "fs-extra": "^11.3.4",
    "handlebars": "^4.7.8",
    "highlight.js": "^11.11.1",
    "http-proxy-middleware": "^3.0.5",
    "lodash-es": "^4.17.23",
    "lowdb": "^7.0.1",
    "marked-highlight": "^2.2.3",
    "mitt": "^3.0.1",
    "module-alias": "^2.3.4",
    "openai": "^6.25.0",
    "phaser": "^3.90.0",
    "sequential-workflow-designer": "^0.37.1",
    "tsconfig-paths": "^4.2.0",
    "vue": "^3.5.28",
    "vxe-pc-ui": "^4.13.16",
    "vxe-table": "^4.18.9",
    "xe-utils": "^4.0.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.3",
    "@jest/globals": "^29.7.0",
    "@playwright/test": "^1.58.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/chokidar": "^1.7.5",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.19.33",
    "@types/pixelmatch": "^5.2.0",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vue/test-utils": "^2.4.6",
    "concurrently": "^9.2.1",
    "electron": "^40.6.0",
    "electron-builder": "^26.8.1",
    "eslint": "^8.56.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "jest": "^29.7.0",
    "marked": "^17.0.5",
    "nodemon": "^3.1.14",
    "pixelmatch": "^7.1.0",
    "pngjs": "^7.0.0",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.21.0",
    "typescript": "^5.3.3",
    "vite": "^7.3.1",
    "ws": "^8.20.0"
  }
}
