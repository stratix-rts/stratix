{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "types": ["jest", "node"],
    // why 允许编译 .js：pixelfx 是**源码进仓的 ESM**（vendor/pixelfx，task_191 / AP-01），
    //   双路由像素一致性测试要 import 它（jest/node 不原生跑 ESM，由 ts-jest 编译成 CJS）。
    "allowJs": true
  },
  "include": [
    "tests/**/*",
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    // playwright 侧资产（spec / page-object / 进程管理），由 tsc -p tsconfig.electron.json 与 playwright 自己编译/运行
    "tests/e2e",
    "tests/utils"
  ]
}
