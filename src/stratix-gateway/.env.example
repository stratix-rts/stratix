# Stratix Gateway 环境配置

# 服务端口配置
PORT=3000
WS_PORT=3001

# 运行环境
NODE_ENV=development

# OpenClaw 配置
OPENCLAW_ENDPOINT=http://localhost:8080
OPENCLAW_API_KEY=your-api-key-here

# 数据库配置
DB_PATH=stratix-data/stratix.db.json

# NocoDB 数据可视化配置
# 设置为 true 启用 NocoDB 服务（需要 Node.js >= 22）
NOCO_ENABLED=false
# NocoDB 服务端口
NOCO_PORT=8080
# JWT secret（生产环境请修改）
NOCO_JWT_SECRET=stratix-nocodb-secret-2026
